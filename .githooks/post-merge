#!/bin/sh
# After a pull in the main checkout, remove worktrees whose work has landed;
# a merge inside a linked worktree never sweeps the others. Never fail the pull.
[ "$(git rev-parse --path-format=absolute --git-dir)" = "$(git rev-parse --path-format=absolute --git-common-dir)" ] || exit 0
"$(git rev-parse --show-toplevel)/scripts/prune-worktrees" || true
