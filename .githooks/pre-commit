#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"
PY=.venv/bin/python
if [ ! -x "$PY" ]; then
  echo "pre-commit: $PY not found; create the venv first (see AGENTS.md)" >&2
  exit 1
fi
if ! "$PY" -m ruff check --fix --exit-non-zero-on-fix computer_history tests; then
  echo "pre-commit: ruff failed or fixed files; review, re-stage, and commit again" >&2
  exit 1
fi
"$PY" -m pytest -q
if git diff --cached --name-only --no-renames \
  | grep -qE '^(capture-agent/|fixtures/spool/|computer_history/sources/ax_text/|tests/test_capture_e2e\.py$)'; then
  capture-agent/scripts/test.sh
  capture-agent/scripts/e2e.sh
fi
